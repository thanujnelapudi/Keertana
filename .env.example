# Public build-time configuration only. Never put a Supabase secret/service-role
# key or the Turnstile secret in a PUBLIC_ variable.
PUBLIC_COMMENTS_ENABLED=false
PUBLIC_COMMENTS_ENDPOINT=
PUBLIC_TURNSTILE_SITE_KEY=

# Optional GA4 web-stream measurement ID. Blank leaves GA4 and its consent UI off.
# Disable Enhanced Measurement in this stream before activation (see docs/usage-analytics.md).
PUBLIC_GA_MEASUREMENT_ID=
