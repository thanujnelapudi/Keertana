---
// LanguageSelector.astro - Elegant royal pill language selector for Keertana
interface Props {
  activeLang?: string;
  isClientTab?: boolean;
}

const { activeLang = 'telugu', isClientTab = false } = Astro.props;

const items = [
  {
    id: 'english',
    label: 'ENGLISH',
    glyph: 'A',
    fontFamily: "Georgia, 'Playfair Display', serif",
    glyphClass: 'glyph-en',
    motif: 'book',
    href: '/english/',
  },
  {
    id: 'telugu',
    label: 'TELUGU',
    glyph: 'అ',
    fontFamily: "'Noto Sans Telugu Variable', 'Noto Serif Telugu', serif",
    glyphClass: 'glyph-te',
    motif: 'wave',
    href: '/telugu/',
  },
  {
    id: 'hindi',
    label: 'HINDI',
    glyph: 'अ',
    fontFamily: "'Noto Sans Devanagari', 'Noto Serif Devanagari', serif",
    glyphClass: 'glyph-hi',
    motif: 'lotus',
    href: '/hindi/',
  },
];
---

<div class="lang-pill-container" role="tablist" aria-label="Select language">
  {items.map((item) => {
    const isActive = item.id === activeLang;
    return (
      <a
        href={item.href}
        role="tab"
        aria-selected={isActive ? 'true' : 'false'}
        data-lang={item.id}
        class={`lang-segment ${isActive ? 'active' : ''}`}
        title={`Switch to ${item.label}`}
      >
        <span class={`lang-glyph ${item.glyphClass}`} style={`font-family: ${item.fontFamily};`}>
          {item.glyph}
        </span>

        {item.motif === 'book' && (
          <svg class="lang-motif" width="14" height="8" viewBox="0 0 24 14" fill="currentColor" aria-hidden="true">
            <path d="M12 4.5C8 -0.5 1 0.5 1 3.5v7.5c0 .6.5 1 1 1 3.5 0 8.5-1.8 10-4.5 1.5 2.7 6.5 4.5 10 4.5.5 0 1-.4 1-1V3.5c0-3-7-4-11 1z" />
          </svg>
        )}

        {item.motif === 'wave' && (
          <svg class="lang-motif" width="14" height="7" viewBox="0 0 24 12" fill="currentColor" aria-hidden="true">
            <path d="M2 9.5c6-8 14-8 20-2-6 2.2-14 3-20 2z" />
          </svg>
        )}

        {item.motif === 'lotus' && (
          <svg class="lang-motif" width="13" height="8" viewBox="0 0 24 14" fill="currentColor" aria-hidden="true">
            <path d="M12 1.5c-1 3.2-3 5.8-7 7.5 3 .8 7 .8 7-2.8 0 3.6 4 3.6 7 2.8-4-1.7-6-4.3-7-7.5z" />
          </svg>
        )}

        <span class="lang-label">{item.label}</span>
      </a>
    );
  })}
</div>

<style>
  .lang-pill-container {
    display: inline-flex;
    align-items: center;
    background: #f8f5ec;
    border: 1.5px solid #d4af37;
    border-radius: 9999px;
    padding: 4px;
    box-shadow:
      0 4px 18px rgba(212, 175, 55, 0.16),
      0 2px 6px rgba(0, 0, 0, 0.04),
      inset 0 1px 2px rgba(255, 255, 255, 0.8);
    position: relative;
    user-select: none;
    max-width: 100%;
    margin-inline: auto;
  }

  [data-theme="dark"] .lang-pill-container {
    background: #1c1815;
    border-color: #8c7324;
    box-shadow:
      0 4px 20px rgba(0, 0, 0, 0.4),
      0 0 12px rgba(212, 175, 55, 0.15),
      inset 0 1px 1px rgba(255, 255, 255, 0.05);
  }

  .lang-segment {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 68px;
    height: 56px;
    padding: 0 0.75rem;
    border-radius: 26px;
    text-decoration: none;
    color: #211711;
    position: relative;
    transition: all 0.22s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: pointer;
    background: transparent;
  }

  [data-theme="dark"] .lang-segment {
    color: #ede5dd;
  }

  /* Hover state: soft blue glow background (#E6F0FF) */
  .lang-segment:hover:not(.active) {
    background: #e6f0ff;
    color: #1e3a8a;
    box-shadow: 0 2px 8px rgba(30, 58, 138, 0.12);
  }

  [data-theme="dark"] .lang-segment:hover:not(.active) {
    background: #1e293b;
    color: #93c5fd;
  }

  /* Active / Selected state: Royal Blue (#1E3A8A) with golden rim */
  .lang-segment.active {
    background: linear-gradient(145deg, #1e3a8a 0%, #172554 100%);
    color: #ffffff !important;
    box-shadow:
      0 4px 14px rgba(30, 58, 138, 0.4),
      0 0 0 1.5px rgba(212, 175, 55, 0.55),
      inset 0 1px 1px rgba(255, 255, 255, 0.25);
  }

  .lang-glyph {
    font-size: 1.35rem;
    line-height: 1;
    font-weight: 600;
    transition: transform 0.15s ease;
  }

  .glyph-en {
    font-size: 1.45rem;
    font-weight: 600;
  }

  .glyph-te {
    font-size: 1.35rem;
  }

  .glyph-hi {
    font-size: 1.35rem;
  }

  .lang-segment:hover .lang-glyph {
    transform: translateY(-1px);
  }

  .lang-motif {
    margin-top: 2px;
    margin-bottom: 2px;
    opacity: 0.85;
    color: #b58d20;
    transition: color 0.15s ease, opacity 0.15s ease;
  }

  .lang-segment.active .lang-motif {
    color: #f3d478;
    opacity: 1;
  }

  .lang-label {
    font-size: 0.5625rem; /* ~9px */
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    line-height: 1;
    opacity: 0.85;
    font-family: var(--font-sans, system-ui, sans-serif);
  }

  .lang-segment.active .lang-label {
    opacity: 1;
    color: #ffffff;
  }

  @media (max-width: 480px) {
    .lang-segment {
      min-width: 58px;
      height: 52px;
      padding: 0 0.5rem;
    }
    .lang-glyph {
      font-size: 1.25rem;
    }
    .glyph-en {
      font-size: 1.3rem;
    }
  }
</style>
