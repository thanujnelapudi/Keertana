---
import '../styles/browse.css';
---
<script>
  import { readLibrary } from '../../public/local-library.js';
  const list = document.getElementById('song-list');
  if (list) {
    async function refreshRows() {
      let saved: string[] = [];
      try { saved = readLibrary(localStorage).saved; } catch { /* Reading works without storage. */ }
      list!.querySelectorAll<HTMLAnchorElement>('.song-row').forEach(row => {
        const title = row.querySelector<HTMLElement>('.song-title');
        if (!title) return;
        title.lang = list!.dataset.locale || 'en';
        let content = row.querySelector('.song-row-content');
        if (!content) { content = document.createElement('span'); content.className = 'song-row-content'; row.insertBefore(content, title); content.append(title); }
        let language = row.querySelector<HTMLElement>('.song-language');
        if (!language) { language = document.createElement('span'); language.className = 'song-language'; content.append(language); }
        language.textContent = list!.dataset.language || '';
        let badge = row.querySelector<HTMLElement>('.browse-saved');
        if (!badge) { badge = document.createElement('span'); badge.className = 'browse-saved'; badge.textContent = 'Saved'; row.insertBefore(badge, row.querySelector('.song-arrow')); }
        const slug = row.dataset.songSlug || decodeURIComponent(new URL(row.href).pathname.split('/')[2] || '');
        badge.hidden = !saved.includes(slug);
      });
      const shortcut = document.getElementById('library-shortcut');
      if (shortcut) shortcut.hidden = !document.getElementById('local-library') || document.getElementById('local-library')!.hidden;
    }
    new MutationObserver(refreshRows).observe(list, { childList: true });
    const library = document.getElementById('local-library');
    if (library) new MutationObserver(refreshRows).observe(library, { childList: true, subtree: true, attributes: true, attributeFilter: ['hidden'] });
    window.addEventListener('storage', refreshRows);
    window.addEventListener('pageshow', refreshRows);
    refreshRows();
  }
</script>
