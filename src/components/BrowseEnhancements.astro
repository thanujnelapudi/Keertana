---
import '../styles/browse.css';
---
<script>
  import { readLibrary } from '../../public/local-library.js';
  const list = document.getElementById('song-list');

  function textSpan(className: string, text: string, lang?: string) {
    const span = document.createElement('span');
    span.className = className;
    span.textContent = text;
    if (lang) span.lang = lang;
    return span;
  }

  function renderNewRow(row: HTMLAnchorElement, locale: string, language: string) {
    const content = document.createElement('span');
    content.className = 'song-row-content';
    content.append(textSpan('song-title', row.textContent || '', locale));
    if (row.dataset.romanTitle) {
      content.append(textSpan('song-roman-title', row.dataset.romanTitle, locale + '-Latn'));
    }
    content.append(textSpan('song-language', language));
    const saved = textSpan('browse-saved', 'Saved');
    saved.hidden = true;
    const arrow = textSpan('song-arrow', '→');
    arrow.setAttribute('aria-hidden', 'true');
    row.replaceChildren(content, saved, arrow);
  }

  if (list) {
    function refreshRows() {
      let saved: string[] = [];
      try { saved = readLibrary(localStorage).saved; } catch { /* Reading works without storage. */ }
      list!.querySelectorAll<HTMLAnchorElement>('.song-row').forEach(row => {
        if (!row.querySelector('.song-row-content')) {
          renderNewRow(row, list!.dataset.locale || 'en', list!.dataset.language || '');
        }
        const badge = row.querySelector<HTMLElement>('.browse-saved');
        if (badge) badge.hidden = !saved.includes(row.dataset.songSlug || '');
      });
      const shortcut = document.getElementById('library-shortcut');
      if (shortcut) shortcut.hidden = !document.getElementById('local-library') || document.getElementById('local-library')!.hidden;
    }
    new MutationObserver(refreshRows).observe(list, { childList: true });
    const library = document.getElementById('local-library');
    if (library) new MutationObserver(refreshRows).observe(library, { childList: true, subtree: true, attributes: true, attributeFilter: ['hidden'] });
    window.addEventListener('storage', refreshRows);
    window.addEventListener('pageshow', refreshRows);
    refreshRows();
  }
</script>
