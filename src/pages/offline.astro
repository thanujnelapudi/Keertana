---
import Base from '../layouts/Base.astro';
---
<Base
  title="Offline | Keertana"
  description="You are currently offline."
  noindex={true}
>
  <div class="container-page" style="
    max-width: 540px;
    margin-inline: auto;
    text-align: center;
    padding-top: 6rem;
    padding-bottom: 6rem;
  ">
    <div style="
      font-size: 4rem;
      margin-bottom: 1.5rem;
      opacity: 0.6;
    " aria-hidden="true">📡</div>

    <h1 style="
      font-size: clamp(1.5rem, 4vw, 2rem);
      font-weight: 700;
      color: var(--text);
      margin: 0 0 1rem;
      font-family: Georgia, 'Noto Sans Telugu Variable', serif;
    ">You're Offline</h1>

    <p style="
      color: var(--text-muted);
      font-size: 1rem;
      line-height: 1.6;
      margin: 0 0 2rem;
    ">
      It looks like you've lost your internet connection. Pages you've visited before should still be available. Try going back or check your connection.
    </p>

    <a
      href="/"
      style="
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.625rem 1.5rem;
        border-radius: 8px;
        background: var(--accent);
        color: #fff;
        font-size: 0.9375rem;
        font-weight: 500;
        text-decoration: none;
        transition: background 0.15s;
      "
    >← Try Home Page</a>
  </div>
</Base>
