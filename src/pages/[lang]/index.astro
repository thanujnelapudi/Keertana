---
import SongRow from '../../components/SongRow.astro';
import BrowseEnhancements from '../../components/BrowseEnhancements.astro';
import Base from '../../layouts/Base.astro';
import LocalLibrary from '../../components/LocalLibrary.astro';
import { getLanguagesData, type LangData } from '../../lib/songs';

export function getStaticPaths() {
  const languages = getLanguagesData();
  return languages.map((lang) => ({
    params: { lang: lang.id },
    props: { lang, allLanguages: languages },
  }));
}

interface Props {
  lang: LangData;
  allLanguages: LangData[];
}

const { lang, allLanguages } = Astro.props;

const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, '') : 'https://keertana.vercel.app';
const canonical = `${siteUrl}/${lang.id}/`;

const title = `${lang.label} Christian Songs & Lyrics | Keertana`;
const description = `Discover ${lang.label} Christian worship songs and hymns. Browse ${lang.songs.length} song lyrics alphabetically on Keertana.`;

const hreflang = allLanguages.map((l) => ({
  lang: l.locale,
  href: `${siteUrl}/${l.id}/`,
}));

const PER_PAGE = 24;
const initialSongs = lang.songs.slice(0, PER_PAGE);
const totalPages = Math.ceil(lang.songs.length / PER_PAGE);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: `${lang.label} Christian Songs & Lyrics`,
    url: canonical,
    description,
    inLanguage: lang.locale,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Keertana', item: `${siteUrl}/` },
      { '@type': 'ListItem', position: 2, name: `${lang.label} Songs`, item: canonical },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: `${lang.label} Christian Songs`,
    numberOfItems: lang.songs.length,
    itemListElement: initialSongs.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: s.title,
      url: `${siteUrl}/song/${s.slug}/`,
    })),
  },
];

const songsData = lang.songs.map((s) => ({ slug: s.slug, title: s.title }));
---

<Base
  title={title}
  description={description}
  jsonLd={jsonLd}
  canonical={canonical}
  lang={lang.locale}
  hreflang={hreflang}
  ogLocale={lang.locale === 'te' ? 'te_IN' : lang.locale === 'hi' ? 'hi_IN' : 'en_US'}
>
  <!-- Hero Section -->
  <section class="hero-section collection-hero" style="
    padding-top: 4.5rem;
    padding-bottom: 3.5rem;
    text-align: center;
    border-bottom: 1px solid var(--border);
  ">
    <div class="container-page" style="max-width: 720px; margin-inline: auto;">
      <!-- Breadcrumb -->
      <nav aria-label="Breadcrumb" style="margin-bottom: 1.5rem;">
        <ol style="list-style: none; padding: 0; margin: 0; display: inline-flex; align-items: center; gap: 0.375rem; font-size: 0.8125rem; color: var(--text-faint); flex-wrap: wrap; justify-content: center;">
          <li><a href="/" style="color: var(--text-muted); text-decoration: none; transition: color 0.15s;">Keertana</a></li>
          <li style="opacity: 0.5;">›</li>
          <li aria-current="page" style="color: var(--text); font-weight: 500;">{lang.label} Songs</li>
        </ol>
      </nav>

      <h1 style="
        font-size: clamp(2rem, 5.5vw, 3.25rem);
        font-weight: 700;
        letter-spacing: -0.03em;
        line-height: 1.15;
        color: var(--text);
        margin: 0 0 0.75rem;
      ">
        {lang.label} Worship Songs
      </h1>
      <p style="
        font-size: 1.125rem;
        color: var(--text-muted);
        line-height: 1.6;
        margin: 0;
      ">
        Browse {lang.songs.length.toLocaleString()} songs and hymns with lyrics.
      </p>
    </div>
  </section>

  <!-- Browse section -->
  <section class="browse-section" style="padding-top: 3rem; padding-bottom: 5rem;">
    <div class="container-page">

      <!-- Language Switcher tabs -->
      <LocalLibrary />
      <div role="tablist" aria-label="Select language" style="
        display: flex;
        gap: 0;
        border-bottom: 1px solid var(--border);
        margin-bottom: 2rem;
        overflow-x: auto;
        scrollbar-width: none;
      ">
        {allLanguages.map((l) => (
          <a
            href={`/${l.id}/`}
            role="tab"
            aria-selected={l.id === lang.id ? 'true' : 'false'}
            class="lang-tab"
            style="
              padding: 0.75rem 1.25rem;
              font-size: 0.9375rem;
              font-weight: 600;
              color: var(--text-muted);
              text-decoration: none;
              border-bottom: 2px solid transparent;
              margin-bottom: -1px;
              white-space: nowrap;
              transition: all 0.15s;
            "
          >
            {l.label}
          </a>
        ))}
      </div>

      <!-- Letter Filter Grid -->
      <div style="margin-bottom: 2.5rem;">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.875rem;">
          <h2 style="
            font-size: 0.75rem;
            font-weight: 600;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--text-faint);
            margin: 0;
          ">Filter by First Letter</h2>
          <span style="font-size: 0.8125rem; color: var(--text-muted);">{lang.songs.length} total songs</span>
        </div>

        <div class="alpha-grid" role="group" aria-label={`${lang.label} alphabet filter`}>
          <!-- 'All' Option -->
          <a
            href={`/${lang.id}/`}
            class="alpha-btn active"
            aria-current="page"
            title="All songs"
          >
            All
          </a>

          <!-- Alphabet letters -->
          {lang.allLetters.filter(l => l.count > 0).map((l) =>
            l.count > 0 ? (
              <a
                href={`/${lang.id}/${encodeURIComponent(l.char)}/`}
                class="alpha-btn"
                title={`${l.char} · ${l.count} ${l.count === 1 ? 'song' : 'songs'}`}
              >
                {l.char}
              </a>
            ) : null
          )}
        </div>
      </div>

      <!-- Song List Header -->
      <div style="
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1rem;
        padding-bottom: 0.75rem;
        border-bottom: 1px solid var(--border);
      ">
        <h3 style="
          font-size: 0.8125rem;
          font-weight: 600;
          letter-spacing: 0.08em;
          text-transform: uppercase;
          color: var(--text-muted);
          margin: 0;
        ">
          All {lang.label} Songs
        </h3>
        <span id="song-count-badge" style="font-size: 0.8125rem; color: var(--text-faint);">
          Showing 1–{Math.min(initialSongs.length, lang.songs.length)} of {lang.songs.length}
        </span>
      </div>

      <!-- Songs list -->
      <div id="song-list" data-language={lang.label} data-locale={lang.locale} style="
        display: grid;
        grid-template-columns: 1fr;
      ">
        {initialSongs.map((song) => (
          <SongRow song={song} label={lang.label} locale={lang.locale} />
        ))}
      </div>

      <!-- Load More / Progressive Enhancement -->
      {totalPages > 1 && (
        <div id="load-more-container" style="margin-top: 3rem; text-align: center;">
          <a
            id="load-more-btn"
            href={`/${lang.id}/page/2/`}
            data-next-page="2"
            data-total-pages={totalPages}
            class="load-more-button"
          >
            Load more songs
          </a>
          <noscript>
            <div style="margin-top: 1rem;">
              <a href={`/${lang.id}/page/2/`} style="color: var(--accent); font-weight: 500; font-size: 0.9375rem;">Next page (2 of {totalPages}) →</a>
            </div>
          </noscript>
        </div>
      )}

    </div>
  </section>
  <BrowseEnhancements />
</Base>

<style>
  .browse-section:has(#local-library:not([hidden])) { padding-top: 2rem !important; }
  .lang-tab[aria-selected="true"] {
    color: var(--accent) !important;
    border-bottom-color: var(--accent) !important;
  }
  .lang-tab:hover {
    color: var(--accent);
  }

  .alpha-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  :global(.alpha-btn) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.5rem;
    height: 2.5rem;
    padding: 0 0.5rem;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  :global(.alpha-btn:hover:not(.alpha-btn-disabled)) {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-bg);
  }

  :global(.alpha-btn.active) {
    background: var(--accent) !important;
    color: var(--on-accent) !important;
    border-color: var(--accent) !important;
    font-weight: 700;
  }

  :global(.alpha-btn-disabled) {
    opacity: 0.35;
    cursor: not-allowed;
    background: transparent;
    border-color: var(--border-subtle);
    color: var(--text-faint);
  }

  :global(.song-row) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.875rem 0.25rem;
    min-height: 3.5rem;
    border-bottom: 1px solid var(--border-subtle);
    text-decoration: none;
    color: var(--text);
    transition: background 0.1s, padding-left 0.1s;
    gap: 1rem;
    border-radius: 0;
  }
  :global(.song-row:hover) {
    background: var(--surface);
    padding-left: 0.75rem;
    color: var(--accent);
  }
  :global(.song-row:hover .song-arrow) {
    color: var(--accent);
    transform: translateX(2px);
  }
  :global(.song-title) {
    font-size: 1.125rem;
    font-weight: 500;
    line-height: 1.5;
    flex: 1;
    min-width: 0;
  }
  :global(.song-arrow) {
    color: var(--text-muted);
    opacity: 1;
    flex-shrink: 0;
    font-size: 1rem;
    transition: color 0.15s, transform 0.15s;
  }

  .load-more-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 2rem;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    box-shadow: var(--shadow-sm);
    transition: all 0.15s ease;
  }
  .load-more-button:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-bg);
  }

  @media (min-width: 768px) {
    #song-list {
      grid-template-columns: 1fr 1fr !important;
      column-gap: 2.5rem !important;
    }
  }
</style>

<script define:vars={{ allSongs: songsData, langId: lang.id }}>
  const PER_PAGE = 24;
  let loadedCount = Math.min(PER_PAGE, allSongs.length);
  const totalCount = allSongs.length;
  const totalPages = Math.ceil(totalCount / PER_PAGE);

  const loadMoreBtn = document.getElementById('load-more-btn');
  const songList = document.getElementById('song-list');
  const badge = document.getElementById('song-count-badge');

  loadMoreBtn?.addEventListener('click', (e) => {
    // If ordinary left click, intercept and progressively enhance
    if (e.button === 0 && !e.metaKey && !e.ctrlKey && !e.shiftKey && !e.altKey) {
      e.preventDefault();
      const nextBatch = allSongs.slice(loadedCount, loadedCount + PER_PAGE);
      const fragment = document.createDocumentFragment();

      for (const song of nextBatch) {
        const a = document.createElement('a');
        a.href = `/song/${encodeURIComponent(song.slug)}/`;
        a.className = 'song-row';
        a.innerHTML = `<span class="song-title">${song.title}</span><span class="song-arrow" aria-hidden="true">→</span>`;
        fragment.appendChild(a);
      }
      songList.appendChild(fragment);

      loadedCount += nextBatch.length;
      const nextPage = Math.floor(loadedCount / PER_PAGE) + 1;

      if (badge) {
        badge.textContent = `Showing 1–${loadedCount} of ${totalCount}`;
      }

      if (loadedCount >= totalCount) {
        loadMoreBtn.style.display = 'none';
      } else {
        loadMoreBtn.setAttribute('href', `/${langId}/page/${nextPage}/`);
        loadMoreBtn.setAttribute('data-next-page', nextPage.toString());
      }
    }
  });
</script>
