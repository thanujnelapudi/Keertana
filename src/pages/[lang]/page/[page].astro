---
import SongRow from '../../../components/SongRow.astro';
import BrowseEnhancements from '../../../components/BrowseEnhancements.astro';
import Base from '../../../layouts/Base.astro';
import { getLanguagesData, type LangData, type Song } from '../../../lib/songs';

export function getStaticPaths() {
  const languages = getLanguagesData();
  const PER_PAGE = 24;

  return languages.flatMap((lang) => {
    const totalPages = Math.ceil(lang.songs.length / PER_PAGE);
    const paths = [];

    for (let p = 2; p <= totalPages; p++) {
      const pageSongs = lang.songs.slice((p - 1) * PER_PAGE, p * PER_PAGE);
      paths.push({
        params: { lang: lang.id, page: String(p) },
        props: {
          lang,
          currentPage: p,
          totalPages,
          pageSongs,
          allLanguages: languages,
        },
      });
    }
    return paths;
  });
}

interface Props {
  lang: LangData;
  currentPage: number;
  totalPages: number;
  pageSongs: Song[];
  allLanguages: LangData[];
}

const { lang, currentPage, totalPages, pageSongs, allLanguages } = Astro.props;

const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, '') : 'https://keertana.vercel.app';
const canonical = `${siteUrl}/${lang.id}/page/${currentPage}/`;

const title = `${lang.label} Christian Songs & Lyrics — Page ${currentPage} | Keertana`;
const description = `Browse ${lang.label} Christian worship songs and hymns — Page ${currentPage} of ${totalPages} on Keertana.`;

const startIdx = (currentPage - 1) * 24 + 1;
const endIdx = Math.min(currentPage * 24, lang.songs.length);

const prevPageUrl = currentPage === 2 ? `/${lang.id}/` : `/${lang.id}/page/${currentPage - 1}/`;
const nextPageUrl = currentPage < totalPages ? `/${lang.id}/page/${currentPage + 1}/` : null;
---

<Base
  title={title}
  description={description}
  canonical={canonical}
  lang={lang.locale}
  ogLocale={lang.locale === 'te' ? 'te_IN' : lang.locale === 'hi' ? 'hi_IN' : 'en_US'}
>
  <section class="hero-section collection-hero" style="
    padding-top: 4rem;
    padding-bottom: 3rem;
    text-align: center;
    border-bottom: 1px solid var(--border);
  ">
    <div class="container-page" style="max-width: 720px; margin-inline: auto;">
      <nav aria-label="Breadcrumb" style="margin-bottom: 1.5rem;">
        <ol style="list-style: none; padding: 0; margin: 0; display: inline-flex; align-items: center; gap: 0.375rem; font-size: 0.8125rem; color: var(--text-faint); flex-wrap: wrap; justify-content: center;">
          <li><a href="/" style="color: var(--text-muted); text-decoration: none;">Keertana</a></li>
          <li style="opacity: 0.5;">›</li>
          <li><a href={`/${lang.id}/`} style="color: var(--text-muted); text-decoration: none;">{lang.label} Songs</a></li>
          <li style="opacity: 0.5;">›</li>
          <li aria-current="page" style="color: var(--text); font-weight: 500;">Page {currentPage}</li>
        </ol>
      </nav>

      <h1 style="
        font-size: clamp(2rem, 5vw, 3rem);
        font-weight: 700;
        letter-spacing: -0.03em;
        line-height: 1.15;
        color: var(--text);
        margin: 0 0 0.5rem;
      ">
        {lang.label} Songs — Page {currentPage}
      </h1>
      <p style="font-size: 1rem; color: var(--text-muted); margin: 0;">
        Showing songs {startIdx}–{endIdx} of {lang.songs.length}
      </p>
    </div>
  </section>

  <section class="browse-section" style="padding-top: 3rem; padding-bottom: 5rem;">
    <div class="container-page">

      <!-- Songs list -->
      <div id="song-list" data-language={lang.label} data-locale={lang.locale} style="display: grid; grid-template-columns: 1fr;">
        {pageSongs.map((song) => (
          <SongRow song={song} label={lang.label} locale={lang.locale} />
        ))}
      </div>

      <!-- Pagination Navigation -->
      <nav aria-label="Pagination" style="margin-top: 3.5rem; display: flex; align-items: center; justify-content: center; gap: 1rem;">
        <a href={prevPageUrl} class="page-nav-btn">← Previous Page</a>
        <span style="font-size: 0.875rem; color: var(--text-muted); font-weight: 500;">Page {currentPage} of {totalPages}</span>
        {nextPageUrl ? (
          <a href={nextPageUrl} class="page-nav-btn">Next Page →</a>
        ) : (
          <span class="page-nav-btn disabled">Next Page →</span>
        )}
      </nav>

      <div style="margin-top: 2rem; text-align: center;">
        <a href={`/${lang.id}/`} style="color: var(--accent); font-size: 0.875rem; text-decoration: none; font-weight: 500;">
          ← Back to first page
        </a>
      </div>

    </div>
  </section>
  <BrowseEnhancements />
</Base>

<style>
  .song-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.875rem 0.25rem;
    min-height: 3.5rem;
    border-bottom: 1px solid var(--border-subtle);
    text-decoration: none;
    color: var(--text);
    transition: background 0.1s, padding-left 0.1s;
    gap: 1rem;
  }
  .song-row:hover {
    background: var(--surface);
    padding-left: 0.75rem;
    color: var(--accent);
  }
  .song-row:hover .song-arrow {
    color: var(--accent);
    transform: translateX(2px);
  }
  .song-title {
    font-size: 1.125rem;
    font-weight: 500;
    line-height: 1.5;
    flex: 1;
    min-width: 0;
  }
  .song-arrow {
    color: var(--text-muted);
    opacity: 1;
    font-size: 1rem;
    transition: color 0.15s, transform 0.15s;
  }

  .page-nav-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem 1.25rem;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.15s;
  }
  .page-nav-btn:hover:not(.disabled) {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-bg);
  }
  .page-nav-btn.disabled {
    opacity: 0.4;
    cursor: default;
    pointer-events: none;
  }

  @media (min-width: 768px) {
    #song-list {
      grid-template-columns: 1fr 1fr !important;
      column-gap: 2.5rem !important;
    }
  }
</style>
