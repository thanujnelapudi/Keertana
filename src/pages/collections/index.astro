---
import Base from '../../layouts/Base.astro';
import CollectionCards from '../../components/CollectionCards.astro';
import { collectionDecisions, worshipCollections } from '../../lib/worship-collections';
import '../../styles/collections.css';
---
<Base title="Telugu Christian Song Collections by Theme and Occasion | Keertana" description={`Explore ${worshipCollections.length} Christian song collections covering all ${collectionDecisions.length} Telugu songs, from worship and prayer to grace, love, Christmas, and Easter.`}>
  <div class="container-page worship-collections-page">
    <nav class="collections-breadcrumb" aria-label="Breadcrumb"><a href="/">Keertana</a><span aria-hidden="true">/</span><span aria-current="page">Collections</span></nav>
    <header class="collections-intro"><p class="collections-eyebrow">{worshipCollections.length} COLLECTIONS</p><h1>Telugu Christian song collections</h1><p>Choose songs for Sunday School, Christmas, prayer or a worship service. If you know the title, <a href="/telugu/">browse all {collectionDecisions.length.toLocaleString('en-IN')} Telugu songs</a>.</p></header>
    <CollectionCards />
    <section class="collections-guidance"><h2>Make the selection yours</h2><p>These public collections are starting points. Your personal setlists let you choose songs from any language and arrange them in the order you’ll sing.</p><a href="/setlists/">Open your worship setlists →</a></section>
  </div>
</Base>
