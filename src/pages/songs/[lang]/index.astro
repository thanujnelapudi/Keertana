---
import { getLanguagesData, songs } from '../../../lib/songs';

export function getStaticPaths() {
  const languages = getLanguagesData();
  return [
    ...languages.map(lang => ({ params: { lang: lang.id }, props: { destination: `/${lang.id}/` } })),
    ...songs.map(song => ({ params: { lang: song.slug }, props: { destination: `/song/${song.slug}/` } })),
    { params: { lang: 'athyunnatha-simhasanamupai' }, props: { destination: '/song/athyunnatha-simhaasanamupai/' } },
  ];
}

return Astro.redirect(Astro.props.destination, 301);
---
