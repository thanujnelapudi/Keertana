---
import Base from '../layouts/Base.astro';
import '../styles/setlists.css';
---
<Base title="Your Worship Setlists | Keertana" description="Arrange songs for worship, read them in order, and print your lyrics." noindex>
  <div class="container-page setlist-page">
    <header class="setlist-intro">
      <p class="setlist-eyebrow">PREPARE · SING · WORSHIP</p>
      <h1>A little order.<br />More room for worship.</h1>
      <p>Bring your songs together, in the order you’ll sing them.</p>
      <p class="setlist-note">Kept in this browser. No account needed. Clearing browser data removes your lists.</p>
    </header>
    <noscript>Enable JavaScript to create and use your local setlists.</noscript>
    <p id="setlist-status" role="status" aria-live="polite">Loading your workspace…</p>
    <div class="setlist-workspace" id="setlist-workspace" hidden>
      <aside class="setlist-sidebar" aria-label="Your setlists">
        <h2>Your setlists</h2>
        <form id="create-setlist"><label for="setlist-name">New setlist name</label><input id="setlist-name" maxlength="80" required placeholder="Sunday worship" /><button type="submit" class="setlist-primary">Create setlist</button></form>
        <ul id="setlist-tabs"></ul>
        <button id="backup-setlists" type="button">Download backup</button>
      </aside>
      <section class="setlist-editor" aria-label="Setlist editor">
        <div id="setlist-empty"><h2>Start with a song. Make it a gathering.</h2><p>Create your first setlist to arrange songs from any language together.</p></div>
        <div id="setlist-detail" hidden>
          <div class="setlist-heading"><h2 id="active-setlist-name"></h2><span id="setlist-count"></span></div>
          <form id="rename-setlist" class="setlist-inline"><label for="rename-name">Setlist name</label><input id="rename-name" maxlength="80" required /><button type="submit">Rename</button></form>
          <div class="setlist-actions"><button id="read-setlist" type="button">Read in order</button><button id="print-setlist" type="button">Print lyrics</button><button id="share-setlist" type="button">Share setlist</button><button id="delete-setlist" type="button">Delete setlist</button></div>
          <div id="delete-confirmation" hidden><p id="delete-question"></p><button id="confirm-delete-setlist" type="button">Yes, delete this setlist</button> <button id="cancel-delete-setlist" type="button">Keep setlist</button></div>
          <div id="share-link-panel" hidden><label for="setlist-share-link">Share this link with your worship team</label><input id="setlist-share-link" readonly /><button id="copy-setlist-link" type="button">Copy link</button><p class="setlist-note">Anyone with the link can view this snapshot. Later edits need a new link.</p></div>
          <p class="setlist-note">Use ↑ and ↓ to arrange songs. Changes save immediately.</p>
          <ol id="setlist-songs"></ol>
          <section class="setlist-picker" aria-label="Find songs to add">
            <h3>Add your next song</h3><label for="setlist-search">Search by title or Roman spelling</label><input id="setlist-search" type="search" placeholder="Try Amazing Grace or a transliterated title" autocomplete="off" />
            <button type="button" id="pick-saved">Browse Saved Songs</button>
            <p id="setlist-search-status" role="status"></p><ul id="setlist-results"></ul>
          </section>
        </div>
      </section>
    </div>
    <section id="shared-setlist" hidden aria-label="Shared worship setlist"><p class="setlist-eyebrow">SHARED FOR WORSHIP</p><h2 id="shared-setlist-name"></h2><p class="setlist-note">A shared snapshot. Your own saved lists remain unchanged.</p><ol id="shared-setlist-songs"></ol><div class="setlist-actions"><button id="read-shared-setlist" type="button">Read shared lyrics</button><button id="print-shared-setlist" type="button">Print shared lyrics</button><a href="/setlists/">Open your own setlists →</a></div></section>
    <section id="setlist-reading" hidden aria-label="Setlist lyrics"><button id="close-setlist-reading" type="button">← Back to setlist</button><div id="setlist-lyrics"></div></section>
  </div>
  <script src="../scripts/setlist-workspace.js"></script>
</Base>
